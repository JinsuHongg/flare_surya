#!/usr/bin/bash
# Submit with: qsub -v RECOVERY_CONFIG=configs/nas/validation_inference/surya_c_run.yaml \
#   shell_scripts/nas/recover_validation_predictions_gh.pbs
#
# The manifest names exactly one checkpoint. Run once with --dry-run first by
# setting DRY_RUN=1 in the qsub variable list.
#PBS -S /usr/bin/bash
#PBS -l select=1:ncpus=72:ngpus=1:mem=256GB:model=gh200
#PBS -q gpu_normal
#PBS -l walltime=24:00:00
#PBS -W umask=002

set -euo pipefail

: "${RECOVERY_CONFIG:?Set RECOVERY_CONFIG to one validation-inference YAML file.}"
: "${CONDA_SH:?Set CONDA_SH to the cluster conda profile script.}"

cd "$PBS_O_WORKDIR"
mkdir -p logs/validation_recovery
job_id=${PBS_JOBID%%.*}
exec >"logs/validation_recovery/recovery.${job_id}.out"
exec 2>"logs/validation_recovery/recovery.${job_id}.err"

source "$CONDA_SH"
conda activate "${CONDA_ENV:-flare_surya}"

command=(python scripts/analysis/run_validation_recovery.py --config "$RECOVERY_CONFIG")
if [[ "${DRY_RUN:-0}" == "1" ]]; then
  command+=(--dry-run)
fi
"${command[@]}"
