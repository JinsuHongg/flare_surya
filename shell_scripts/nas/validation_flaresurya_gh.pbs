#!/usr/bin/bash
# Submit: qsub shell_scripts/nas/validation_flaresurya_gh.pbs
#PBS -S /usr/bin/bash
#PBS -N validation_surya_gh
#PBS -l select=1:ncpus=10:ngpus=1:mem=70GB:model=gh200
#PBS -q gpu_normal
#PBS -l walltime=24:00:00
#PBS -W umask=002

set -euo pipefail
cd "$PBS_O_WORKDIR"
mkdir -p logs/validation
job_id=${PBS_JOBID%%.*}
exec >"logs/validation/validation_surya_gh.${job_id}.out"
exec 2>"logs/validation/validation_surya_gh.${job_id}.err"

source /nobackupp17/jhong15/miniforge3_gh/etc/profile.d/conda.sh
conda activate flare_surya
recovery_config=${RECOVERY_CONFIG:-configs/nas/validation_inference/surya_c_run.yaml}
if [[ ! -f "$recovery_config" ]]; then
  echo "Validation recovery config does not exist: $recovery_config" >&2
  exit 1
fi
python scripts/analysis/run_validation_recovery.py \
  --config "$recovery_config"
